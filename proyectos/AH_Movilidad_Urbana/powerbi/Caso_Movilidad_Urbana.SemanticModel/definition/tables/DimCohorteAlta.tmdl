table DimCohorteAlta
	lineageTag: 107f4ad6-d06a-5168-8b23-73b6516b0fe7

	column CohorteAlta
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 32575656-0e89-5422-b353-bb572af48005
		summarizeBy: none
		sourceColumn: [CohorteAlta]

		annotation UnderlyingDateTimeDataType = Date

	column MesNumero = MONTH(DimCohorteAlta[CohorteAlta])
		dataType: int64
		formatString: 0
		lineageTag: 3f8b721c-1203-5960-85c3-3bdb739c9316
		summarizeBy: none

	column Mes = FORMAT(DimCohorteAlta[CohorteAlta], "mmm", "es-ES")
		dataType: string
		lineageTag: bd7d131e-c158-5aae-affd-2e30e7678c34
		summarizeBy: none
		sortByColumn: MesNumero

	partition DimCohorteAlta = calculated
		mode: import
		source =
				VAR Fechas = DISTINCT(SELECTCOLUMNS(FactUsuarioAno, "CohorteAlta", FactUsuarioAno[CohorteAlta]))
				RETURN FILTER(Fechas, NOT ISBLANK([CohorteAlta]))

