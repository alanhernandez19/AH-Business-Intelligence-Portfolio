	column FechaVisitaDia =
			
			DATE(
			    YEAR(FactVisitas[FechaVisita]),
			    MONTH(FactVisitas[FechaVisita]),
			    DAY(FactVisitas[FechaVisita])
			)
		formatString: dd/mm/yyyy
		lineageTag: 6a17c708-d878-4c4a-afb2-060107fd115b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column IdVisita
		dataType: int64
		formatString: 0
		lineageTag: b7ddc784-4eb8-43ff-8167-2333e2d06ccf
		summarizeBy: none
		sourceColumn: IdVisita

		annotation SummarizationSetBy = Automatic

	partition FactVisitas = m
		mode: import
		source =
				let
				    // 1. Origen de datos
				    Origen = Excel.Workbook(
				        File.Contents(pArchivo),
				        null,
				        true
				    ),
				
				    CONSOLIDADO_Sheet = Origen{[
				        Item = "CONSOLIDADO",
				        Kind = "Sheet"
				    ]}[Data],
				
				    // 2. Promover encabezados
				    #"Encabezados promovidos" = Table.PromoteHeaders(
				        CONSOLIDADO_Sheet,
				        [PromoteAllScalars = true]
				    ),
				
				    // 3. Asignar tipos a las 26 columnas
				    #"Tipos iniciales" = Table.TransformColumnTypes(
				        #"Encabezados promovidos",
				        {
				            {"email", type text},
				            {"CampoExtra", type text},
				            {"Badmail", type text},
				            {"Baja", type text},
				            {"Fecha envio", type datetime},
				            {"Fecha open", type text},
				            {"Opens", Int64.Type},
				            {"Opens virales", Int64.Type},
				            {"Fecha click", type text},
				            {"Clicks", Int64.Type},
				            {"Clicks virales", Int64.Type},
				            {"Links", type text},
				            {"IPs", type text},
				            {"Navegadores", type text},
				            {"Plataformas", type text},
				            {"ArchivoOrigen", type text},
				            {"FechaVisita_Texto", type datetime},
				            {"OrigenFechaVisita", type text},
				            {"FechaVisita", type datetime},
				            {"VisitasRegistro", Int64.Type},
				            {"EmailNormalizado", type text},
				
				            // Columnas analíticas
				            {"NavegadorAnalitico", type text},
				            {"PlataformaAnalitica", type text},
				            {"EstadoBadmail", type text},
				            {"EstadoBaja", type text},
				
				            // Identificador generado en el ETL de Excel
				            {"IdVisita", Int64.Type}
				        },
				        "es-MX"
				    ),
				
				    // 4. Limpiar fechas originales
				    #"Fechas originales limpias" = Table.TransformColumns(
				        #"Tipos iniciales",
				        {
				            {
				                "Fecha open",
				                each
				                    if _ = null then
				                        null
				                    else if
				                        Text.Trim(Text.From(_)) = "-" or
				                        Text.Trim(Text.From(_)) = ""
				                    then
				                        null
				                    else
				                        Text.Trim(Text.From(_)),
				                type nullable text
				            },
				            {
				                "Fecha click",
				                each
				                    if _ = null then
				                        null
				                    else if
				                        Text.Trim(Text.From(_)) = "-" or
				                        Text.Trim(Text.From(_)) = ""
				                    then
				                        null
				                    else
				                        Text.Trim(Text.From(_)),
				                type nullable text
				            }
				        }
				    ),
				
				    // 5. Convertir fechas originales a datetime
				    #"Fechas convertidas" = Table.TransformColumns(
				        #"Fechas originales limpias",
				        {
				            {
				                "Fecha open",
				                each
				                    try DateTime.FromText(_, [Culture = "es-MX"])
				                    otherwise null,
				                type nullable datetime
				            },
				            {
				                "Fecha click",
				                each
				                    try DateTime.FromText(_, [Culture = "es-MX"])
				                    otherwise null,
				                type nullable datetime
				            }
				        }
				    )
				in
				    #"Fechas convertidas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

