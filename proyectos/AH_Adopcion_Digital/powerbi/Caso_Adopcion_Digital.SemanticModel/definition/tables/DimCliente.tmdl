	column BandaInternetMunicipio = SWITCH ( TRUE (), ISBLANK ( DimCliente[PorcentajeInternetMunicipio2020] ), "Sin dato", DimCliente[PorcentajeInternetMunicipio2020] <= 0.4, "≤40%", DimCliente[PorcentajeInternetMunicipio2020] <= 0.6, "40-60%", DimCliente[PorcentajeInternetMunicipio2020] <= 0.8, "60-80%", ">80%" )
		lineageTag: aa471b91-a2c8-5ba3-b870-d4ef041ccf5e
		summarizeBy: none
		sortByColumn: OrdenBandaInternetMunicipio

	column OrdenBandaInternetMunicipio = SWITCH ( TRUE (), ISBLANK ( DimCliente[PorcentajeInternetMunicipio2020] ), 5, DimCliente[PorcentajeInternetMunicipio2020] <= 0.4, 1, DimCliente[PorcentajeInternetMunicipio2020] <= 0.6, 2, DimCliente[PorcentajeInternetMunicipio2020] <= 0.8, 3, 4 )
		dataType: int64
		formatString: 0
		lineageTag: 788ae0e1-5577-5a73-8af2-d8db01e6cdc8
		summarizeBy: none

	column EstadoMapaISO = SWITCH ( DimCliente[EstadoClave], "01", "MX-AGU", "02", "MX-BCN", "03", "MX-BCS", "04", "MX-CAM", "05", "MX-COA", "06", "MX-COL", "07", "MX-CHP", "08", "MX-CHH", "09", "MX-DIF", "10", "MX-DUR", "11", "MX-GUA", "12", "MX-GRO", "13", "MX-HID", "14", "MX-JAL", "15", "MX-MEX", "16", "MX-MIC", "17", "MX-MOR", "18", "MX-NAY", "19", "MX-NLE", "20", "MX-OAX", "21", "MX-PUE", "22", "MX-QUE", "23", "MX-ROO", "24", "MX-SLP", "25", "MX-SIN", "26", "MX-SON", "27", "MX-TAB", "28", "MX-TAM", "29", "MX-TLA", "30", "MX-VER", "31", "MX-YUC", "32", "MX-ZAC", BLANK () )
		lineageTag: 25582fee-b36d-51a7-9233-9781b9ad333f
		dataCategory: StateOrProvince
		summarizeBy: none

	column EstadoVisual = COALESCE ( DimCliente[NombreEstado], "Sin domicilio válido" )
