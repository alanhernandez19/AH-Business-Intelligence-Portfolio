	partition DimCliente = m
		mode: import
		source =
				let
				    ArchivoSalida = "\DimCliente.csv",
				    Origen = Csv.Document(
				        File.Contents(pArchivo & ArchivoSalida),
				        [Delimiter = ",", Columns = 20, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Encabezados promovidos" = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    #"Vacíos como nulos" = Table.ReplaceValue(
				        #"Encabezados promovidos", "", null, Replacer.ReplaceValue,
				        Table.ColumnNames(#"Encabezados promovidos")
				    ),
				    #"Tipo cambiado" = Table.TransformColumnTypes(
				        #"Vacíos como nulos",
				        {
				            {"ClienteKey", Int64.Type},
				            {"EdadObservada", type number},
				            {"MunicipioDomicilioCve", type text},
				            {"CuentasEnMaestro", Int64.Type},
				            {"ClienteReferencia", type text},
				            {"SegmentoOrigenCodigo", type text},
				            {"EdadDisponible", Int64.Type},
				            {"EdadMayor100Revisar", Int64.Type},
				            {"GrupoEdad", type text},
				            {"SegmentoDisponible", Int64.Type},
				            {"MunicipioNombre", type text},
				            {"EstadoClave", type text},
				            {"IndiceTerritorialFuente2020", type number},
				            {"NombreEstado", type text},
				            {"PoblacionMunicipio2020", Int64.Type},
				            {"ViviendasConCaracteristicas2020", Int64.Type},
				            {"ViviendasInternet2020", Int64.Type},
				            {"PorcentajeInternetMunicipio2020", type number},
				            {"CensoMunicipalDisponible", Int64.Type},
				            {"DomicilioMunicipioValido", Int64.Type}
				        },
				        "en-US"
				    )
				in
				    #"Tipo cambiado"

