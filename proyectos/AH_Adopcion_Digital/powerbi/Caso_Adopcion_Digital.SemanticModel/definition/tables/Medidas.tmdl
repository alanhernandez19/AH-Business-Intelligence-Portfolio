		formatString: 0.00%
		lineageTag: bd0e420c-d331-568b-bf4c-42cdac3077b4

	measure '48. Tasa 30 visible' = IF ( [14. Base elegibles 30] >= 200, FORMAT ( [16. Base tasa 30], "0.00%" ), "n<200" )
		lineageTag: 95125eaf-1abe-594d-9b65-b93b49a147aa

	measure '49. Tasa 90 visible' = IF ( [17. Base elegibles 90] >= 200, FORMAT ( [19. Base tasa 90], "0.00%" ), "n<200" )
		lineageTag: 3bb5269c-f23c-5a7c-817f-13bf468a6819

	measure '50. Tasa 180 visible' = IF ( [20. Base elegibles 180] >= 200, FORMAT ( [22. Base tasa 180], "0.00%" ), "n<200" )
		lineageTag: b827363e-bd51-5eec-9d20-e77ab5243cc4

	measure '51. Tasa posterior visible' = IF ( [23. Candidatos día 30] >= 200, FORMAT ( [25. Tasa días 31 a 90], "0.00%" ), "n<200" )
