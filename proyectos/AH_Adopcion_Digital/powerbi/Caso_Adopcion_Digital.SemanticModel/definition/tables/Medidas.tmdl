	measure '32. Tickets fuente' = DISTINCTCOUNT ( FactMovimientos[TicketKey] )
		formatString: #,0
		lineageTag: 472b47f0-daec-50df-af29-d2c1b27a69e8

	measure '33. Tickets Internet' = CALCULATE ( [32. Tickets fuente], DimTienda[Canal] = "Internet" )
