	measure '7. Clientes con domicilio válido' = CALCULATE ( DISTINCTCOUNT ( FactClienteCorte[ClienteKey] ), DimCliente[DomicilioMunicipioValido] = 1 )
		formatString: #,0
		lineageTag: d11a3221-856d-5cd5-87a3-d0b4dfe6dcd1

	measure '8. Cobertura domicilio' = DIVIDE ( [7. Clientes con domicilio válido], [1. Clientes observados] )
		formatString: 0.00%
		lineageTag: 1570434f-058d-5c99-bcd3-92e516f63244

	measure '9. Clientes con edad' = SUM ( DimCliente[EdadDisponible] )
		formatString: #,0
		lineageTag: c6489c61-4c3c-5e9e-b0e6-8180344f3e07

	measure '10. Cobertura edad' = DIVIDE ( [9. Clientes con edad], COUNTROWS ( DimCliente ) )
		formatString: 0.00%
		lineageTag: d58ebea6-ec46-57bb-8797-5078b2b2e807

	measure '11. Productos catalogados' = SUM ( DimProducto[ProductoEnCatalogo] )
