		lineageTag: b3e153d8-bd84-5bb9-b0f5-a71b901fa7bb

	measure '38. Cobertura tiendas' = DIVIDE ( SUM ( DimTienda[TiendaEnCatalogo] ), COUNTROWS ( DimTienda ) )
		formatString: 0.00%
		lineageTag: ed7b4b5e-31c8-5a7d-88b1-92bd5a23daf0

	measure '39. Cobertura productos' = DIVIDE ( SUM ( DimProducto[ProductoEnCatalogo] ), COUNTROWS ( DimProducto ) )
		formatString: 0.000%
		lineageTag: d0d3a753-ba8e-584a-b9f3-3d3439bb8965

	measure '40. Alcance supuesto' = SELECTEDVALUE ( ParamAlcance[Alcance], 0.25 )
		formatString: 0%
		lineageTag: 08c18a3f-efc9-555e-b6b8-8c5b6f38729d

	measure '41. Mejora supuesta' = SELECTEDVALUE ( ParamMejora[Mejora], 0.02 )
		formatString: 0.0%
		lineageTag: db603d44-0dad-5f90-954b-bf4056620aba

	measure '42. Tickets por nuevo adoptante' = SELECTEDVALUE ( ParamTickets[Tickets], 2 )
		formatString: #,0
		lineageTag: 14ae0955-2a25-5297-91a0-5f84f401e40a

	measure '43. Nuevos adoptantes ilustrativos' = ROUND ( [23. Candidatos día 30] * [40. Alcance supuesto] * [41. Mejora supuesta], 0 )
		formatString: #,0
		lineageTag: 48c8a899-ed3d-54bd-843b-f2aba20bd86e

	measure '44. Tickets ilustrativos' = [43. Nuevos adoptantes ilustrativos] * [42. Tickets por nuevo adoptante]
		formatString: #,0
		lineageTag: 8e6a9136-77ac-55d7-8d61-7748093f84b4

	measure '45. Elegibles por regla' = IF ( HASONEVALUE ( DimReglaAnalisis[ReglaKey] ), [2. Elegibles 90] )
