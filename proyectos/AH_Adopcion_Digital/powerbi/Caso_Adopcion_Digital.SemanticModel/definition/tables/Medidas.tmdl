		lineageTag: 97f1244a-eeb2-585e-ba21-d0ecfb6046a9

	measure '17. Base elegibles 90' = CALCULATE ( COUNT ( FactClienteCorte[Adopto90] ), FactClienteCorte[ReglaKey] = 1 )
		formatString: #,0
