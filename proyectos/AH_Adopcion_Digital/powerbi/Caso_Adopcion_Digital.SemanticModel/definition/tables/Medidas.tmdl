table Medidas
	lineageTag: 29d825ae-f4f8-43ed-84e3-860251b1ae37

	measure '1. Clientes observados' = DISTINCTCOUNT ( FactClienteCorte[ClienteKey] )
		formatString: #,0
		lineageTag: 92ee99d7-b717-4db3-bde6-312e1a895533

	measure '2. Elegibles 90' = COUNT ( FactClienteCorte[Adopto90] )
		formatString: #,0
		lineageTag: 9b1df60c-5e48-454f-9f70-a89fc40e5f03

	measure '3. Adoptantes 90' = SUM ( FactClienteCorte[Adopto90] )
		formatString: #,0
		lineageTag: ccf21bf4-b9f4-42b2-ab10-568d94647a1e

	measure '4. Tasa adopción 90' = DIVIDE ( [3. Adoptantes 90], [2. Elegibles 90] )
		formatString: 0.00%
		lineageTag: f3165740-5014-4a16-9947-5d5d882fb5ea

	measure '5. Recurrencia 90' = AVERAGE ( FactClienteCorte[Recompra90] )
		formatString: 0.00%
