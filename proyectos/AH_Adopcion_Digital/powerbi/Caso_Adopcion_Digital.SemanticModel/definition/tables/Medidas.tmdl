		lineageTag: dece7ffc-a954-5a4f-858a-6d1abf6b05e6

	measure '36. Importe positivo fuente' = CALCULATE ( [35. Importe firmado fuente], FactMovimientos[ImporteFirmado] > 0 )
		formatString: #,0.00
		lineageTag: a5fc3c60-ab55-5f45-bc85-64daef75a695

	measure '37. Importe negativo fuente' = CALCULATE ( [35. Importe firmado fuente], FactMovimientos[ImporteFirmado] < 0 )
