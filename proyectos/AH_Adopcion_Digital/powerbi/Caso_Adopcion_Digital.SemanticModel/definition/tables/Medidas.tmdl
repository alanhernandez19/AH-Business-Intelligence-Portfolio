	measure '13. Base clientes' = CALCULATE ( DISTINCTCOUNT ( FactClienteCorte[ClienteKey] ), FactClienteCorte[ReglaKey] = 1 )
		formatString: #,0
		lineageTag: 1dc9052b-63dc-5e01-a394-dea66041e1a6

	measure '14. Base elegibles 30' = CALCULATE ( COUNT ( FactClienteCorte[Adopto30] ), FactClienteCorte[ReglaKey] = 1 )
		formatString: #,0
		lineageTag: 9bd8e781-956b-5ac4-8107-292187b06104

