	measure '23. Candidatos día 30' = CALCULATE ( SUM ( FactClienteCorte[CandidatoDia30] ), FactClienteCorte[ReglaKey] = 1 )
		formatString: #,0
		lineageTag: a580c5d0-c83b-5115-b16b-1ebe4633734a

	measure '24. Adoptantes días 31 a 90' = CALCULATE ( SUM ( FactClienteCorte[Adopto31a90] ), FactClienteCorte[ReglaKey] = 1 )
