	column GrupoVisitasPrevias = SWITCH ( TRUE (), ISBLANK ( FactClienteCorte[VisitasAntecedentes] ), "Sin dato", FactClienteCorte[VisitasAntecedentes] <= 2, "0-2", FactClienteCorte[VisitasAntecedentes] <= 5, "3-5", FactClienteCorte[VisitasAntecedentes] <= 10, "6-10", "11+" )
