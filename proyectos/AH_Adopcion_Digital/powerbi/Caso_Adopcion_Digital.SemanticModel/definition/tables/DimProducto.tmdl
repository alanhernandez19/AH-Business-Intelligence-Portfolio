	partition DimProducto = m
		mode: import
		source =
				let
				    ArchivoSalida = "\DimProducto.csv",
				    Origen = Csv.Document(
				        File.Contents(pArchivo & ArchivoSalida),
				        [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Encabezados promovidos" = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    #"Vacíos como nulos" = Table.ReplaceValue(
				        #"Encabezados promovidos", "", null, Replacer.ReplaceValue,
				        Table.ColumnNames(#"Encabezados promovidos")
				    ),
				    #"Tipo cambiado" = Table.TransformColumnTypes(
				        #"Vacíos como nulos",
				        {
				            {"ProductoKey", Int64.Type},
				            {"ProductoCodigoFuente", type text},
				            {"MarcaCodigo", type text},
				            {"CategoriaCodigo", type text},
				            {"ProductoEnCatalogo", Int64.Type},
				            {"CategoriaNombre", type text},
				            {"MarcaCategoriaCodigo", type text}
				        },
				        "en-US"
				    )
				in
				    #"Tipo cambiado"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

