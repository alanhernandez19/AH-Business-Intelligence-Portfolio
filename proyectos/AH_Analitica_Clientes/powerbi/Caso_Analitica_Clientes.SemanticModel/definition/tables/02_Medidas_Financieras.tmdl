table 02_Medidas_Financieras
	lineageTag: 18a74de2-8c4f-4842-a418-e404634c4010

	measure '1. Saldo agregado total' = SUM(FactClientes[balance])
		formatString: #,0.00
		lineageTag: f9444c3e-79e4-48ca-ad3f-297581719364

	measure '2. Saldo promedio cuenta' = ```
				AVERAGE(FactClientes[balance])
			```
		formatString: #,0.00
		lineageTag: 6fce8dce-dac6-4548-8201-e15c0b1c4f5d

	measure '3. Saldo agregado bajas' = ```
				CALCULATE([1. Saldo agregado total], FactClientes[churn] = 1)
			```
		formatString: #,0.00
		lineageTag: 8c70ea2d-7afc-4494-b1d0-56a3419d66a5

	measure '4. Saldo medio bajas' = ```
