	column cuadrante
		dataType: string
		lineageTag: 300f58a9-24e9-42f1-a8c8-4824780131e1
		summarizeBy: none
		sourceColumn: cuadrante

		annotation SummarizationSetBy = Automatic

	column 'Cuadrante breve' =
			SWITCH(
			    RadarSegmentos[cuadrante],
			    "Tasa alta / Volumen alto", "Alto / Alto",
			    "Tasa alta / Volumen bajo", "Alto / Bajo",
			    "Tasa baja / Volumen alto", "Bajo / Alto",
			    "Tasa baja / Volumen bajo", "Bajo / Bajo",
			    RadarSegmentos[cuadrante]
			)
		dataType: string
		lineageTag: 0867701a-77a3-45f1-89fa-a7983614fd2a
		summarizeBy: none

	column 'Regla visible' = ```
			VAR R =
			    SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(
			        RadarSegmentos[regla],
			        "products_number", "Productos"), "active_member", "Actividad"),
			        "credit_card", "Tarjeta"), "edad_banda", "Edad"),
			        "saldo_estado", "Saldo"), "country", "País"), " | ", " · ")
			RETURN
			    SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(
			        R, "Actividad=0", "Inactivo"), "Actividad=1", "Activo"),
			        "Tarjeta=0", "Sin tarjeta"), "Tarjeta=1", "Con tarjeta"),
			        "País=France", "País=Francia"), "País=Germany", "País=Alemania")
			
			```
		dataType: string
		lineageTag: f7796fe5-c781-42e9-8dc7-aa8a31ecac09
		summarizeBy: none

	partition RadarSegmentos = m
		mode: import
		source =
				let
				    // 1. Origen del archivo Excel
				    Origen = Excel.Workbook(
				        File.Contents(pArchivoExcel),
				        null,
				        true
				    ),
				
				    // 2. Seleccionar la hoja RadarSegmentos
				    RadarSegmentos_Sheet = Origen{
				        [Item = "RadarSegmentos", Kind = "Sheet"]
				    }[Data],
				
				    // 3. Promover encabezados
				    #"Encabezados promovidos" = Table.PromoteHeaders(
				        RadarSegmentos_Sheet,
				        [PromoteAllScalars = true]
				    ),
				
				    // 4. Aplicar tipos de datos
				    #"Tipo cambiado" = Table.TransformColumnTypes(
				        #"Encabezados promovidos",
				        {
				            {"segmento_id", type text},
				            {"regla", type text},
				            {"estructura", type text},
				            {"clientes", Int64.Type},
				            {"bajas", Int64.Type},
				            {"churn_pct", type number},
				            {"contribucion_bajas_pct", type number},
				            {"participacion_clientes_pct", type number},
				            {"indice_relativo_churn", type number},
				            {"exceso_descriptivo", type number},
				            {"saldo_asociado_bajas", type number},
				            {"cuadrante", type text}
				        },
				        "en-US"
				    ),
				
				    // 5. Normalizar espacios en columnas de texto
				    #"Textos normalizados" = Table.TransformColumns(
				        #"Tipo cambiado",
				        {
				            {"segmento_id", each if _ = null then null else Text.Trim(_), type text},
				            {"regla", each if _ = null then null else Text.Trim(_), type text},
				            {"estructura", each if _ = null then null else Text.Trim(_), type text},
				            {"cuadrante", each if _ = null then null else Text.Trim(_), type text}
				        }
				    )
				
				in
				    #"Textos normalizados"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

