	partition FactClientes = m
		mode: import
		source =
				let
				    // 1. Origen del archivo Excel
				    Origen = Excel.Workbook(
				        File.Contents(pArchivoExcel),
				        null,
				        true
				    ),
				
				    // 2. Seleccionar la hoja principal
				    FactClientes_Sheet = Origen{
				        [Item = "FactClientes", Kind = "Sheet"]
				    }[Data],
				
				    // 3. Promover la primera fila como encabezados
				    #"Encabezados promovidos" = Table.PromoteHeaders(
				        FactClientes_Sheet,
				        [PromoteAllScalars = true]
				    ),
				
				    // 4. Validar que existan las 22 columnas esperadas
				    ColumnasEsperadas = {
				        "customer_id",
				        "credit_score",
				        "country",
				        "gender",
				        "age",
				        "tenure",
				        "balance",
				        "products_number",
				        "credit_card",
				        "active_member",
				        "estimated_salary",
				        "churn",
				        "saldo_estado",
				        "edad_banda",
				        "saldo_banda",
				        "vinculacion_tipo",
				        "perfil_actividad_saldo",
				        "perfil_actividad_productos",
				        "perfil_saldo_producto",
				        "productos_alto_3o4",
				        "hipotesis",
				        "simulable"
				    },
				
				    ColumnasFaltantes = List.Difference(
				        ColumnasEsperadas,
				        Table.ColumnNames(#"Encabezados promovidos")
				    ),
				
				    #"Columnas validadas" =
				        if List.IsEmpty(ColumnasFaltantes) then
				            #"Encabezados promovidos"
				        else
				            error Error.Record(
				                "Estructura incorrecta",
				                "Faltan columnas en FactClientes",
				                ColumnasFaltantes
				            ),
				
				    // 5. Aplicar tipos de datos
				    #"Tipo cambiado" = Table.TransformColumnTypes(
				        #"Columnas validadas",
				        {
				            {"customer_id", Int64.Type},
				            {"credit_score", Int64.Type},
				            {"country", type text},
				            {"gender", type text},
				            {"age", Int64.Type},
				            {"tenure", Int64.Type},
				            {"balance", type number},
				            {"products_number", Int64.Type},
				            {"credit_card", Int64.Type},
				            {"active_member", Int64.Type},
				            {"estimated_salary", type number},
				            {"churn", Int64.Type},
				            {"saldo_estado", type text},
				            {"edad_banda", type text},
				            {"saldo_banda", type text},
				            {"vinculacion_tipo", type text},
				            {"perfil_actividad_saldo", type text},
				            {"perfil_actividad_productos", type text},
				            {"perfil_saldo_producto", type text},
				            {"productos_alto_3o4", Int64.Type},
				            {"hipotesis", type text},
				            {"simulable", Int64.Type}
				        },
				        "en-US"
				    ),
				
				    // 6. Limpiar espacios accidentales en columnas de texto
				    #"Textos normalizados" = Table.TransformColumns(
				        #"Tipo cambiado",
				        List.Transform(
				            {
				                "country",
				                "gender",
				                "saldo_estado",
				                "edad_banda",
				                "saldo_banda",
				                "vinculacion_tipo",
				                "perfil_actividad_saldo",
				                "perfil_actividad_productos",
				                "perfil_saldo_producto",
				                "hipotesis"
				            },
				            (columna) => {
				                columna,
				                each if _ = null then null else Text.Trim(_),
				                type text
				            }
				        )
				    )
				
				in
				    #"Textos normalizados"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

