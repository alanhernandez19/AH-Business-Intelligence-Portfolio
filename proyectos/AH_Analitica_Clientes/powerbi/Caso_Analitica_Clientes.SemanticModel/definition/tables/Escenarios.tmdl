	partition Escenarios = m
		mode: import
		source =
				let
				    // 1. Origen del archivo Excel
				    Origen = Excel.Workbook(
				        File.Contents(pArchivoExcel),
				        null,
				        true
				    ),
				
				    // 2. Seleccionar la hoja Escenarios
				    Escenarios_Sheet = Origen{
				        [Item = "Escenarios", Kind = "Sheet"]
				    }[Data],
				
				    // 3. Promover encabezados
				    #"Encabezados promovidos" = Table.PromoteHeaders(
				        Escenarios_Sheet,
				        [PromoteAllScalars = true]
				    ),
				
				    // 4. Aplicar tipos de datos
				    #"Tipo cambiado" = Table.TransformColumnTypes(
				        #"Encabezados promovidos",
				        {
				            {"escenario", type text},
				            {"hipotesis", type text},
				            {"poblacion", Int64.Type},
				            {"contactos", Int64.Type},
				            {"retenciones_incrementales_esperadas", type number},
				            {"costo", Int64.Type},
				            {"beneficio_margen", Int64.Type},
				            {"beneficio_cac_alternativo", Int64.Type},
				            {"neto_margen", Int64.Type},
				            {"neto_cac_alternativo", Int64.Type}
				        },
				        "en-US"
				    ),
				
				    // 5. Normalizar campos de texto
				    #"Textos normalizados" = Table.TransformColumns(
				        #"Tipo cambiado",
				        {
				            {
				                "escenario",
				                each if _ = null then null else Text.Trim(_),
				                type text
				            },
				            {
				                "hipotesis",
				                each if _ = null then null else Text.Trim(_),
				                type text
				            }
				        }
				    )
				
				in
				    #"Textos normalizados"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

