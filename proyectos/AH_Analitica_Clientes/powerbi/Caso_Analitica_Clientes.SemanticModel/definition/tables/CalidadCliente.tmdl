	partition CalidadCliente = m
		mode: import
		source =
				let
				    // 1. Origen del archivo Excel
				    Origen = Excel.Workbook(
				        File.Contents(pArchivoExcel),
				        null,
				        true
				    ),
				
				    // 2. Seleccionar la hoja CalidadCliente
				    CalidadCliente_Sheet = Origen{
				        [Item = "CalidadCliente", Kind = "Sheet"]
				    }[Data],
				
				    // 3. Promover encabezados
				    #"Encabezados promovidos" = Table.PromoteHeaders(
				        CalidadCliente_Sheet,
				        [PromoteAllScalars = true]
				    ),
				
				    // 4. Aplicar tipos de datos
				    #"Tipo cambiado" = Table.TransformColumnTypes(
				        #"Encabezados promovidos",
				        {
				            {"customer_id", Int64.Type},
				            {"tenure_cero", Int64.Type},
				            {"score_extremo_350_850", Int64.Type},
				            {"salario_menor_100", Int64.Type},
				            {"edad_menos_antiguedad_menor_18", Int64.Type}
				        },
				        "en-US"
				    )
				
				in
				    #"Tipo cambiado"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

