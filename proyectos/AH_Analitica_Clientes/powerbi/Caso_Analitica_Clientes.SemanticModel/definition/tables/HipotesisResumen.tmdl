	partition HipotesisResumen = m
		mode: import
		source =
				let
				    // 1. Origen del archivo Excel
				    Origen = Excel.Workbook(
				        File.Contents(pArchivoExcel),
				        null,
				        true
				    ),
				
				    // 2. Seleccionar la hoja HipotesisResumen
				    HipotesisResumen_Sheet = Origen{
				        [Item = "HipotesisResumen", Kind = "Sheet"]
				    }[Data],
				
				    // 3. Promover encabezados
				    #"Encabezados promovidos" = Table.PromoteHeaders(
				        HipotesisResumen_Sheet,
				        [PromoteAllScalars = true]
				    ),
				
				    // 4. Aplicar tipos de datos
				    #"Tipo cambiado" = Table.TransformColumnTypes(
				        #"Encabezados promovidos",
				        {
				            {"hipotesis", type text},
				            {"clientes", Int64.Type},
				            {"bajas", Int64.Type},
				            {"saldo_observado", type number},
				            {"churn_pct", type number},
				            {"contribucion_bajas_pct", type number}
				        },
				        "en-US"
				    ),
				
				    // 5. Normalizar el campo de hipótesis
				    #"Textos normalizados" = Table.TransformColumns(
				        #"Tipo cambiado",
				        {
				            {
				                "hipotesis",
				                each if _ = null then null else Text.Trim(_),
				                type text
				            }
				        }
				    )
				
				in
				    #"Textos normalizados"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

