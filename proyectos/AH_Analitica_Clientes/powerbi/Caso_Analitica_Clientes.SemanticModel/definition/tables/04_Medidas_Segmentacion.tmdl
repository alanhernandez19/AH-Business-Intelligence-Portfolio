	measure '9. Radar clientes' = ```
				VAR Ids = VALUES(RadarSegmentos[segmento_id])
				VAR ClientesRadar = CALCULATETABLE(VALUES(RadarCliente[customer_id]), TREATAS(Ids, RadarCliente[segmento_id]))
				RETURN IF(HASONEVALUE(RadarSegmentos[segmento_id]), CALCULATE([1. Clientes], TREATAS(ClientesRadar, FactClientes[customer_id])), BLANK())
			```
		formatString: #,0
		lineageTag: 16d67959-a7a9-4c81-bd11-8f7c97570299

	measure '10. Radar bajas' = ```
				VAR Ids = VALUES(RadarSegmentos[segmento_id])
				VAR ClientesRadar = CALCULATETABLE(VALUES(RadarCliente[customer_id]), TREATAS(Ids, RadarCliente[segmento_id]))
				RETURN IF(HASONEVALUE(RadarSegmentos[segmento_id]), CALCULATE([2. Bajas], TREATAS(ClientesRadar, FactClientes[customer_id])), BLANK())
			```
		formatString: #,0
		lineageTag: b216b5cc-6f87-46e5-a6c5-290a4ab22e4b

